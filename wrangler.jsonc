{
  "name": "tabelhafin",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "no_bundle": true,
  "compatibility_date": "2025-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabelhafin-db",
      "database_id": "b1ec4cf7-fd3a-481e-8af6-c274dc7f275c"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DEVICE_TOKENS",
      "id": "712f4da0d5dd41d0820d31431aab4d03"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://tabelhafin.ianptkcs.workers.dev"
  }
}
